{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WebApi": {
    "ApiPrefix": "api",
    "EnableSwagger": true,
    "SwaggerEndpoints": [
      {
        "Version": "v1",
        "Name": "ServiceBus RestAPI V1",
        "SwaggerDocumentUrl": "/swagger/v1/swagger.json",
        "Servers": [
          {
            "Url": "/api/v1",
            "Description": "API V1"
          }
        ]
      }
    ],
    "ServiceBusMonitorOptions": {
      "MonitorIdentifier": "ESBMonitor_1"
    },
    "DBSettings": {
      "DbConnectionSettings": {
        "ADF_ServiceBus": {
          "ConnectionString": "Host=host.docker.internal;Database=legion_adf_servicebus;Port=5432;Username=postgres;Password=postgres;Timeout=120;CommandTimeout=120;MaxPoolSize=20;ApplicationName=Legion.ADF.ServiceBus.RestApi"
        }
      }
    }
  },
  "CacheRestApi": {
    "BaseAddress": "http://10.60.20.162:10903"
  },
  "ADFCache": {
    "DBSettings": {
      "DbConnectionSettings": {
        "ADF_Cache": {
          "ConnectionString": "Host=host.docker.internal;Database=legion_adf_servicebus;Port=5432;Username=postgres;Password=postgres;Timeout=120;CommandTimeout=120;MaxPoolSize=20;ApplicationName=Legion.ADF.ServiceBus.RestApi"
        }
      }
    }
  },
  "ADFLogs": {
    "DBSettings": {
      "DbConnectionSettings": {
        "ADF_Logs": {
          "ConnectionString": "Host=host.docker.internal;Database=legion_adf_servicebus;Port=5432;Username=postgres;Password=postgres;Timeout=120;CommandTimeout=120;MaxPoolSize=20;ApplicationName=Legion.ADF.ServiceBus.RestApi"
        }
      }
    },
    "LoggerSettings": {
      "UseBatchWriter": true,
      "LogMessageMinLogLevel": "Trace",
      "UnstructuredLogMinLogLevel": "Trace"
    },
    "BatchLogMessageStoreOptions": {
      "Period": "00:00:00.020"
    },
    "BatchUnstructuredLogStoreOptions": {
      "Period": "00:00:00.020"
    }
  }
}
