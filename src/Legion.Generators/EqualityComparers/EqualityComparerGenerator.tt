<#+
string? ComputeHash(
	EqualityComparerDescriptor equalityComparerDesc,
	params System.Reflection.MemberInfo[] parameters)
{
	if (parameters == null || parameters.Length == 0)
		return "";

	var fieldsProps = new List<string>();

	for (int i = 0; i < parameters.Length; i++)
	{
		var parameter = parameters[i];
		var type = parameter.GetFieldOrPropertyType();

		if (type.IsDictionary())
			continue;

		if (type.IsSimpleType())
		{
			fieldsProps.Add($"obj.{parameter.Name}");
		}
		else if (type.IsEnumerableSimpleType())
		{
			Type itemType = type.GetEnumerableElementType();

			fieldsProps.Add($"ComparisonHelper.SequenceHashCode(obj.{parameter.Name}, System.Collections.Generic.EqualityComparer<{itemType.ToFriendlyName()}>.Default)");
		}
		else if (type.IsEnumerableType())
		{
			fieldsProps.Add($"ComparisonHelper.SequenceHashCode(obj.{parameter.Name}, System.Collections.Generic.EqualityComparer<{type.GetEnumerableElementType().FullName}>.Default)");
		}
		else //is reference type
		{
			if (equalityComparerDesc.IsComapredByReference(type))
			{
				fieldsProps.Add($"obj.{parameter.Name}?.GetHashCode()");
			}
			else
			{
				fieldsProps.Add(equalityComparerDesc.EmbedToTargetType
					? $"{type.FullName}.{type.Name}EqualityComparer.GetHashCode(obj.{parameter.Name}, comparisonOptions, /*conditions*/null, cache)"
					: $"{equalityComparerDesc.ComparerNamespace ?? type.Namespace!}.{type.Name}EqualityComparer.GetHashCode(obj.{parameter.Name}, comparisonOptions, /*conditions*/null, cache)");
			}
		}
	}

	var sb = new StringBuilder();
	var batch = fieldsProps.Take(8).ToList();
	fieldsProps = fieldsProps.Skip(8).ToList();
	var isFirst = true;
	while (batch.Any())
	{
		if (isFirst)
		{
			sb.AppendLine(batch.Count == 1
				? $"int hash = {batch[0]}?.GetHashCode() ?? 0;"
				: $"int hash = HashCode.Combine({string.Join($",{Environment.NewLine}			", batch)});");
		}
		else
		{
			sb.AppendLine($"		hash = HashCode.Combine(hash, {string.Join($",{Environment.NewLine}			", batch)});");
		}

		batch = fieldsProps.Take(7).ToList();
		fieldsProps = fieldsProps.Skip(7).ToList();
		isFirst = false;
	}

	return sb.ToString();
}
#>