<#
	}
#>

		if (cache.Contains(obj))
			return 0;

<#
		List<System.Reflection.MemberInfo> propsAndFields = equalityComparerDesc.ValueTypeProperties.Select(x => (System.Reflection.MemberInfo)x.PropertyInfo).ToList();
		propsAndFields.AddRange(equalityComparerDesc.ReferenceTypeProperties.Select(x => (System.Reflection.MemberInfo)x.Key.PropertyInfo));
		propsAndFields.AddRange(equalityComparerDesc.CollectionOfReferenceTypeProperties.Select(x => (System.Reflection.MemberInfo)x.Key.PropertyInfo));
		propsAndFields.AddRange(equalityComparerDesc.ValueTypeFields.Select(x => (System.Reflection.MemberInfo)x.FieldInfo));
		propsAndFields.AddRange(equalityComparerDesc.ReferenceTypeFields.Select(x => (System.Reflection.MemberInfo)x.Key.FieldInfo));
		propsAndFields.AddRange(equalityComparerDesc.CollectionOfReferenceTypeFields.Select(x => (System.Reflection.MemberInfo)x.Key.FieldInfo));

