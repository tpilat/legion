	public static int GetHashCode(
		<#= equalityComparerDesc.TargetTypeName #>? obj,
		ComparisonOptions comparisonOptions = ComparisonOptions.CompareAll,
		Action<ComparisonConditions<<#= equalityComparerDesc.TargetTypeName #>>>? conditions = null,
