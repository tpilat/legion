<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>Latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <RootNamespace>Legion.Logging.PostgreSQL</RootNamespace>
    <PackageId>Legion.Logging.PostgreSQL</PackageId>
    <Description>Legion.Logging.PostgreSQL</Description>
    <PackageTags></PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReleaseNotes></PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/legion-dotnet/legion</PackageProjectUrl>
    <RepositoryUrl>https://github.com/legion-dotnet/legion</RepositoryUrl>
    <PackageIcon>legion.png</PackageIcon>
    <NeutralLanguage>en</NeutralLanguage>
    <Copyright>Copyright LEGION</Copyright>
    <Authors>Tomas Pilat</Authors>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
  </PropertyGroup>

  <Import Project="../../SharedConfigurations.props" />

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\legion.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Legion\Legion.csproj" />
    <ProjectReference Include="..\Legion.EntityFrameworkCore\Legion.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\Legion.EntityFrameworkCore.PostgreSQL\Legion.EntityFrameworkCore.PostgreSQL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\\Legion\\bin\\Release\\net8.0\\Legion.dll">
      <Pack>true</Pack>
      <PackagePath>lib/net8.0/</PackagePath>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\\Legion.EntityFrameworkCore\\bin\\Release\\net8.0\\Legion.EntityFrameworkCore.dll">
      <Pack>true</Pack>
      <PackagePath>lib/net8.0/</PackagePath>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\\Legion.EntityFrameworkCore.PostgreSQL\\bin\\Release\\net8.0\\Legion.EntityFrameworkCore.PostgreSQL.dll">
      <Pack>true</Pack>
      <PackagePath>lib/net8.0/</PackagePath>
    </Content>
  </ItemGroup>
  <PropertyGroup>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>
</Project>
